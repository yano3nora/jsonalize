{
  "tasks": {
    "dev": "deno test --watch",
    "check": "deno fmt --check && deno lint && deno check main.ts scripts/release.ts",
    "test": "deno test",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "compile": "deno compile --output jsonalize main.ts"
  },
  "fmt": {
    "exclude": ["README.md"],
    "singleQuote": true,
    "semiColons": false
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1"
  }
}
